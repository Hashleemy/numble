{
  "name": "numble-root",
  "private": true,
  "workspaces": [
    "shared",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:mobile": "npm --prefix mobile run start",
    "test": "npm run test --workspaces --if-present",
    "test:shared": "npm run test -w shared",
    "test:web": "npm run test -w web",
    "build": "npm run build -w web"
  }
}
